# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/ai_ids_db
MONGO_DB_NAME=ai_ids_db

# Flask Application Settings
SECRET_KEY=threatwatch-secret-key-change-in-production
HOST=127.0.0.1
PORT=5000
SESSION_MINUTES=30
HTTPS=0

# Default Admin Credentials (used only on first startup)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Simulation & Demo Settings
SEED_DEMO=1
SEED_ROWS=5000
REPLAY=1
DATASET=KDDTest+.txt

# Machine-to-Machine Ingestion API Key (Optional)
INGEST_API_KEY=

# Email Alert Configuration (SMTP over STARTTLS) (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=threatwatch@localhost
ALERT_EMAIL_TO=

# Firebase Authentication Configuration (Google OAuth & Password Recovery)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps
FIREBASE_PROJECT_ID=threatwatch-a41a0
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=threatwatch-a41a0.firebaseapp.com
FIREBASE_STORAGE_BUCKET=threatwatch-a41a0.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=289561180633
FIREBASE_APP_ID=
# Comma-separated list of allowed email domains (leave blank to allow all valid accounts)
# Example: ALLOWED_DOMAINS=gmail.com,st.niituniversity.in
ALLOWED_DOMAINS=
